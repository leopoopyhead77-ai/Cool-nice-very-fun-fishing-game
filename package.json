{
  "name": "sounding-line",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "fonts": "node build/fonts.mjs",
    "icon": "node build/icon.mjs",
    "apk": "npm run build && bash build/apk.sh",
    "balance": "node build/balance.mjs",
    "test": "node build/smoke.mjs && node build/bridge-test.mjs && node build/rebirth-test.mjs",
    "auth:build": "node auth/build/build.mjs",
    "auth:icon": "node auth/build/icon.mjs",
    "auth:apk": "npm run auth:build && bash auth/build/apk.sh",
    "auth:test": "node auth/build/otp-test.mjs && node auth/build/app-test.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.49.1",
    "qrcode": "^1.5.4"
  },
  "description": "Sounding Line — a Fisch-style deep-water fishing game, shipped as a single-file web build and an Android APK."
}
